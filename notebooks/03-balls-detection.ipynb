    "def patch_corner_holes(state):\n",
    "    distance_tl = np.linalg.norm(state.tl_inner - state.tl_outer)\n",
    "    distance_tr = np.linalg.norm(state.tr_inner - state.tr_outer)\n",
    "    distance_br = np.linalg.norm(state.br_inner - state.br_outer)\n",
    "    distance_bl = np.linalg.norm(state.bl_inner - state.bl_outer)\n",
    "\n",
    "    tl_hole=(state.tl_inner+state.tl_outer)/2\n",
    "    tr_hole=(state.tr_inner+state.tr_outer)/2\n",
    "    br_hole=(state.br_inner+state.br_outer)/2\n",
    "    bl_hole=(state.bl_inner+state.bl_outer)/2\n",
    "\n",
    "    circle_hsv_color = (state.h_med, state.s_med, state.v_med) \n",
    "\n",
    "    tl = (int(tl_hole[0]), int(tl_hole[1]))\n",
    "    tr = (int(tr_hole[0]), int(tr_hole[1]))\n",
    "    br = (int(br_hole[0]), int(br_hole[1]))\n",
    "    bl = (int(bl_hole[0]), int(bl_hole[1]))\n",
    "\n",
    "    cv2.circle(state.hsv_image_shadow_masked, tl, int(distance_tl/2), circle_hsv_color, 1) #just line for top\n",
    "    cv2.circle(state.hsv_image_shadow_masked, tr, int(distance_tr/2), circle_hsv_color, 1)\n",
    "    cv2.circle(state.hsv_image_shadow_masked, br, int(distance_br/2)+10, circle_hsv_color, -1) #fill for bottom\n",
    "    cv2.circle(state.hsv_image_shadow_masked, bl, int(distance_bl/2)+10, circle_hsv_color, -1)\n",
    "\n",
    "    height, width = state.hsv_image_shadow_masked.shape[:2]\n",
    "    xx, yy = np.meshgrid(np.arange(width), np.arange(height))\n",
    "    coords = np.stack([xx.ravel(), yy.ravel()], axis=-1)\n",
    "\n",
    "    # Line Mask \n",
    "    A, B, C = state.top_line_inner_full\n",
    "    y_line = -(A * coords[:, 0] + C) / B\n",
    "    mask_line_flat = coords[:, 1] < y_line \n",
    "\n",
    "    # Circle Masks\n",
    "    # Calculate circle radius based on distances between inner and outer points, with some padding\n",
    "    radius_tl = int(distance_tl/2) +25\n",
    "    radius_tr = int(distance_tr/2) + 30\n",
    "\n",
    "    # Create boolean masks for points inside the top-left and top-right circles\n",
    "    mask_circle_tl_flat = (coords[:, 0] - tl[0])**2 + (coords[:, 1] - tl[1])**2 <= radius_tl**2\n",
    "    mask_circle_tr_flat = (coords[:, 0] - tr[0])**2 + (coords[:, 1] - tr[1])**2 <= radius_tr**2\n",
    "\n",
    "    mask_top_circles_flat = mask_circle_tl_flat | mask_circle_tr_flat\n",
    "\n",
    "    # Combine Line and Circle Conditions\n",
    "    # The point must be above the line and inside one of the top circles\n",
    "    final_mask_flat = mask_line_flat & mask_top_circles_flat\n",
    "    final_mask = final_mask_flat.reshape(height, width)\n",
    "\n",
    "    state.hsv_image_shadow_masked[final_mask] = [state.h_med, state.s_med, state.v_med]\n",
    "\n",
    "    #patch holes in top view\n",
    "    if state.is_top:\n",
    "        cv2.circle(state.hsv_image_shadow_masked, (int(state.tl_outer[0]), int(state.tl_outer[1])), int(distance_tl/2)+50, circle_hsv_color, -1)\n",
    "        cv2.circle(state.hsv_image_shadow_masked, (int(state.tr_outer[0]), int(state.tr_outer[1])), int(distance_tr/2)+50, circle_hsv_color, -1)\n",
    "        cv2.circle(state.hsv_image_shadow_masked, (int(state.br_outer[0]), int(state.br_outer[1])), int(distance_br/2)+50, circle_hsv_color, -1)\n",
    "        cv2.circle(state.hsv_image_shadow_masked, (int(state.bl_outer[0]), int(state.bl_outer[1])), int(distance_bl/2)+50, circle_hsv_color, -1)\n",
    "        mid_point_upper = ((state.tl_outer + state.tr_outer) / 2).astype(int)\n",
    "        mid_point_lower = ((state.bl_outer + state.br_outer) / 2).astype(int)\n",
    "        cv2.circle(state.hsv_image_shadow_masked, (mid_point_upper[0], mid_point_upper[1]), int(distance_tl/2)+50, circle_hsv_color, -1)\n",
    "        cv2.circle(state.hsv_image_shadow_masked, (mid_point_lower[0], mid_point_lower[1]), int(distance_tl/2)+50, circle_hsv_color, -1)\n",
    "    \n",
    "    #patch holes and sides in front view\n",
    "    if state.is_front:\n",
    "        A_out, B_out, C_out = state.side_line_r_outer_full\n",
    "        A_in, B_in, C_in = state.side_line_r_inner_full\n",
    "\n",
    "        y_line_r_outer = -(A_out * coords[:, 0] + C_out) / B_out\n",
    "        y_line_r_inner = -(A_in * coords[:, 0] + C_in) / B_in\n",
    "        \n",
    "        A_out_l, B_out_l, C_out_l = state.side_line_l_outer_full\n",
    "        A_in_l, B_in_l, C_in_l = state.side_line_l_inner_full\n",
    "\n",
    "        y_line_l_outer = -(A_out_l * coords[:, 0] + C_out_l) / B_out_l\n",
