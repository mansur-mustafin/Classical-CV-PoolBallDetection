    "        mask_side_combined_flat = (mask_above_inner_flat & mask_below_outer_flat) | (mask_above_inner_flat_l & mask_below_outer_flat_l) \n",
    "        final_side_mask = mask_side_combined_flat.reshape(height, width)\n",
    "\n",
