    "\n",
    "\"\"\"\"\n",
    "# 1. Convert your existing HSV image to BGR so OpenCV displays the colors correctly\n",
    "display_image = cv2.cvtColor(state.hsv_image, cv2.COLOR_HSV2BGR)\n",
    "\n",
    "# Create a copy so we can draw tiny dots on it when you click\n",
    "clone = display_image.copy()\n",
    "\n",
    "def sample_color(event, x, y, flags, param):\n",
    "    # Only trigger when the left mouse button is clicked\n",
    "    if event == cv2.EVENT_LBUTTONDOWN:\n",
    "        # OpenCV reads the display image in BGR format\n",
    "        bgr_color = display_image[y, x]\n",
    "        \n",
    "        # Convert the single BGR pixel to HSV\n",
    "        hsv_color = cv2.cvtColor(np.uint8([[bgr_color]]), cv2.COLOR_BGR2HSV)[0][0]\n",
    "        h, s, v = hsv_color[0], hsv_color[1], hsv_color[2]\n",
    "        \n",
    "        # Print the exact format you need to copy/paste in HSV\n",
    "        print(f\"np.array([{h}, {s}, {v}]),  # Sampled at ({x}, {y})\")\n",
    "        \n",
    "        # Draw a tiny green dot where you clicked so you know you got it\n",
    "        cv2.circle(clone, (x, y), 2, (0, 255, 0), -1)\n",
    "        cv2.imshow(\"Manual Color Sampler\", clone)\n",
    "\n",
    "# 2. Set up the interactive window and attach the mouse click event\n",
    "cv2.namedWindow(\"Manual Color Sampler\")\n",
    "cv2.setMouseCallback(\"Manual Color Sampler\", sample_color)\n",
    "\n",
    "print(\"--- MANUAL COLOR SAMPLER ---\")\n",
    "print(\"1. Click on the truest color of a ball (avoid the white glare and dark shadows).\")\n",
    "print(\"2. Copy the printed array from your console.\")\n",
    "print(\"3. Press 'q' or 'ESC' on your keyboard while the window is selected to close it.\")\n",
    "\n",
    "# 3. Keep the window open until you press 'q'\n",
    "while True:\n",
    "    cv2.imshow(\"Manual Color Sampler\", clone)\n",
    "    key = cv2.waitKey(1) & 0xFF\n",
    "    \n",
    "    # Exit loop if 'q' or 'ESC' is pressed\n",
    "    if key == ord(\"q\") or key == 27:\n",
    "        break\n",
    "\n",
    "# Clean up\n",
    "cv2.destroyAllWindows()\n",
    "cv2.waitKey(1)\"\"\""
   ]
  },
