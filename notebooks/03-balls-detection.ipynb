    "    threshold=80,\n",
    "    minLineLength=100,\n",
    "    maxLineGap=80\n",
    ")\n",
    "\n",
    "tmp_lines = []\n",
    "for line in lines:\n",
    "    x1, y1, x2, y2 = line[0]\n",
    "    length = math.sqrt((x2 - x1) ** 2 + (y2 - y1) ** 2)\n",
    "    if length >= 250:\n",
    "        tmp_lines.append(line)\n",
    "lines = tmp_lines\n",
    "\n",
    "pts = []\n",
    "for line in lines:\n",
    "    x1, y1, x2, y2 = line[0]\n",
    "    pts.append((x1, y1))\n",
    "    pts.append((x2, y2))\n",
    "\n",
    "pts = np.array(pts)\n",
    "hull = cv2.convexHull(pts)\n",
