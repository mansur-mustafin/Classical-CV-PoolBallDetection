    "def make_line(p1, p2):\n",
    "    p1 = np.array(p1, dtype=np.float32)\n",
    "    p2 = np.array(p2, dtype=np.float32)\n",
    "\n",
    "    A = p1[1] - p2[1]\n",
    "    B = p2[0] - p1[0]\n",
    "    C = p1[0]*p2[1] - p2[0]*p1[1]\n",
    "\n",
    "    return A, B, C"
   ]
